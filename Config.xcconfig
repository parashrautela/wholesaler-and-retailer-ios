// Jewel India — iOS build configuration
//
// Values mirror the web app's .env exactly (Jewel-India-Frontend/.env).
// The `$()` splice is the standard xcconfig escape that stops `//` in a URL
// from being parsed as a comment.

SUPABASE_URL = https:/$()/ljxgwiuvdpuarvdszjts.supabase.co
SUPABASE_ANON_KEY = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImxqeGd3aXV2ZHB1YXJ2ZHN6anRzIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzE0MzczNTksImV4cCI6MjA4NzAxMzM1OX0.7tLGTSHxwc5MyY5qaYO1sbHZmdPNrE0ZI2Wr-zeS-_I

// NEXT_PUBLIC_API_URL — the AI pipeline service
AI_PIPELINE_URL = https:/$()/ai-pipeline-production-3f9a.up.railway.app

// NEXT_PUBLIC_SITE_URL — deployed Next host, used for the few endpoints that
// require server-side privileges and for OAuth / email redirect callbacks.
SITE_URL = https:/$()/app.jewelindia.shop

// ─── Native Google Sign-In ───────────────────────────────────────────────────
//
// The browser-based OAuth flow hands off to Supabase, which decides where to
// redirect back to. When the app's custom scheme is not allow-listed there,
// Supabase substitutes the Site URL and the auth sheet loads the *web app*
// instead of returning — the sheet then has no matching callback and never
// closes. Signing in natively removes that hop entirely: Google returns an ID
// token straight to the app, which is exchanged via `signInWithIdToken`. No
// browser, no redirect, nothing to allow-list.
//
// TO ENABLE — create an **iOS** OAuth client in Google Cloud Console
// (APIs & Services → Credentials → Create Credentials → OAuth client ID →
// iOS, bundle id `com.jewelindia.app`), then fill in the two values below.
// While GOOGLE_IOS_CLIENT_ID is blank the app keeps using the browser flow.
//
//   GOOGLE_IOS_CLIENT_ID           the new iOS client id, ending
//                                  `.apps.googleusercontent.com`
//   GOOGLE_IOS_REVERSED_CLIENT_ID  the same id with its two halves swapped,
//                                  i.e. `com.googleusercontent.apps.<prefix>`
//
// Then add the iOS client id to Supabase → Authentication → Providers →
// Google → "Authorized Client IDs", so the ID token is accepted.
GOOGLE_IOS_CLIENT_ID = 1073798661212-i1pko154oa1k5gsc4pc3ppi84omtht3n.apps.googleusercontent.com
GOOGLE_IOS_REVERSED_CLIENT_ID = com.googleusercontent.apps.1073798661212-i1pko154oa1k5gsc4pc3ppi84omtht3n
